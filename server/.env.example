# Render API configuration
# To get these credentials:
# 1. API Key: Go to Render Dashboard -> Account Settings -> API Keys -> Create API Key.
# 2. Service ID: Go to your service on Render, the Service ID is visible in the URL (e.g., srv-...)

RENDER_API_KEY=your_key_here
RENDER_SERVICE_ID=your_service_id_here

# Firebase web API key (Firebase console -> Project settings -> General).
# Powers POST /api/auth/login (bot SDK email/password login).
FIREBASE_API_KEY=your_firebase_web_api_key_here
